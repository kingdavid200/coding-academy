# Environment variables for Coding Academy.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# --- Database (PostgreSQL) ------------------------------------------------
# Local dev with docker-compose (see docker-compose.yml):
DATABASE_URL="postgresql://codestart:codestart@localhost:5432/codestart?schema=public"
# Production: a hosted Postgres connection string, e.g. from Neon:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Public site URL ---------------------------------------------------
# The canonical origin of the deployment. Drives canonical tags, sitemap.xml,
# robots.txt, Open Graph URLs and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth --------------------------------------------------------------
# Secret used to sign/hash session cookies. Generate: openssl rand -base64 48
AUTH_SECRET="change-me"

# --- Seed data (only read by `npm run db:seed`) -----------------------
SEED_ADMIN_EMAIL="admin@codingacademy.test"
SEED_ADMIN_PASSWORD="Admin!Passw0rd"
SEED_ADMIN_NAME="Platform Admin"
